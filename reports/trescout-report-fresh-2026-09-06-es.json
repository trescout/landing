  "glossary": [
    {
      "term": "skills",
      "explanation": "Habilidades especiales o capacidades de uso de herramientas que adquieren los modelos de inteligencia artificial para realizar una tarea específica."
    },
    {
      "term": "LLM",
      "explanation": "Modelo avanzado de inteligencia artificial entrenado con cantidades masivas de datos, capaz de comprender el lenguaje humano y generar texto."
    },
    {
      "term": "hooks",
      "explanation": "Puntos de conexión que permiten intervenir en el proceso al activarse en un punto específico durante la ejecución de un software."
    },
    {
      "term": "instances",
      "explanation": "Cada copia independiente de un software o sistema que se ejecuta al mismo tiempo."
    }
  ]
