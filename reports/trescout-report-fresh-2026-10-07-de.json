  "glossary": [
    {
      "term": "debugger",
      "explanation": "Ein Hilfsprogramm, das die schrittweise Verfolgung von Code ermöglicht, um Fehler in Software zu finden und zu beheben."
    },
    {
      "term": "multi-process",
      "explanation": "Die Fähigkeit eines Computers, mehrere Aufgaben gleichzeitig als unabhängige Prozesse auszuführen."
    },
    {
      "term": "large language model",
      "explanation": "Künstliche Intelligenzmodelle, die mit sehr großen Datenmengen trainiert wurden und menschliche Sprache verstehen sowie Texte generieren können."
    }
  ]
}
