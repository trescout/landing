  "glossary": [
    {
      "term": "skills",
      "explanation": "Capacités spécifiques ou compétences d'utilisation d'outils acquises par les modèles d'intelligence artificielle pour accomplir une tâche donnée."
    },
    {
      "term": "LLM",
      "explanation": "Modèle d'intelligence artificielle avancé, entraîné sur de très grandes quantités de données, capable de comprendre le langage humain et de générer du texte."
    },
    {
      "term": "hooks",
      "explanation": "Points de connexion permettant d'intervenir dans le processus en s'activant à un moment précis lors de l'exécution d'un logiciel."
    },
    {
      "term": "instances",
      "explanation": "Chaque copie indépendante d'un logiciel ou d'un système fonctionnant simultanément."
    }
  ]
