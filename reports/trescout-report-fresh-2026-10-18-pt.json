  "glossary": [
    {
      "term": "coding agents",
      "explanation": "Programas de inteligência artificial que realizam tarefas como escrever código, depurar e editar de forma autônoma nos processos de desenvolvimento de software."
    },
    {
      "term": "remote runtime",
      "explanation": "Ambiente que permite que o software ou as operações de inteligência artificial sejam executados em um servidor remoto em vez de no computador local."
    },
    {
      "term": "multimodal",
      "explanation": "Sistema capaz de processar não apenas texto, mas também imagens, áudio ou outros tipos de dados simultaneamente."
    },
    {
      "term": "associative memory",
      "explanation": "Uma lógica de processamento de dados que armazena informações de acordo com suas relações entre si e as recupera por meio de associação."
    },
    {
      "term": "SVG",
      "explanation": "Formato de imagem digital desenhado com fórmulas matemáticas que pode ser redimensionado para qualquer tamanho sem perda de qualidade."
    }
  ]
