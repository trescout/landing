  "glossary": [
    {
      "term": "coding agents",
      "explanation": "KI-Programme, die Aufgaben wie das Schreiben, Debuggen und Bearbeiten von Code in Softwareentwicklungsprozessen autonom ausführen."
    },
    {
      "term": "remote runtime",
      "explanation": "Eine Umgebung, die es ermöglicht, Software- oder KI-Prozesse auf einem entfernten Server anstatt auf dem lokalen Computer auszuführen."
    },
    {
      "term": "multimodal",
      "explanation": "Ein System, das nicht nur Text, sondern gleichzeitig auch visuelle, auditive oder andere Datentypen verarbeiten kann."
    },
    {
      "term": "associative memory",
      "explanation": "Eine Datenverarbeitungslogik, die Informationen basierend auf ihren Beziehungen zueinander speichert und durch Assoziationen abruft."
    },
    {
      "term": "SVG",
      "explanation": "Ein digitales Bildformat, das mit mathematischen Formeln gezeichnet wird und ohne Qualitätsverlust auf jede gewünschte Größe skaliert werden kann."
    }
  ]
