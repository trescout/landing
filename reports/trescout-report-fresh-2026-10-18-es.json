  "glossary": [
    {
      "term": "coding agents",
      "explanation": "Programas de inteligencia artificial que realizan tareas como escribir código, depurar y editar de forma autónoma en los procesos de desarrollo de software."
    },
    {
      "term": "remote runtime",
      "explanation": "Entorno que permite ejecutar software o procesos de inteligencia artificial en un servidor remoto en lugar de en la computadora local."
    },
    {
      "term": "multimodal",
      "explanation": "Sistema capaz de procesar no solo texto, sino también imágenes, audio u otros tipos de datos simultáneamente."
    },
    {
      "term": "associative memory",
      "explanation": "Una lógica de procesamiento de datos que almacena la información según sus relaciones entre sí y la recuerda mediante asociaciones."
    },
    {
      "term": "SVG",
      "explanation": "Formato de imagen digital dibujado con fórmulas matemáticas que puede redimensionarse al tamaño deseado sin perder calidad."
    }
  ]
