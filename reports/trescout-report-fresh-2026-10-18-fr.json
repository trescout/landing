  "glossary": [
    {
      "term": "coding agents",
      "explanation": "Programmes d'intelligence artificielle qui effectuent de manière autonome des tâches telles que l'écriture, le débogage et l'édition de code dans les processus de développement logiciel."
    },
    {
      "term": "remote runtime",
      "explanation": "Environnement permettant d'exécuter des logiciels ou des opérations d'intelligence artificielle sur un serveur distant plutôt que sur l'ordinateur local."
    },
    {
      "term": "multimodal",
      "explanation": "Système capable de traiter simultanément non seulement du texte, mais aussi des données visuelles, audio ou d'autres types de données."
    },
    {
      "term": "associative memory",
      "explanation": "Une logique de traitement des données qui stocke les informations en fonction de leurs relations mutuelles et les rappelle par association."
    },
    {
      "term": "SVG",
      "explanation": "Format d'image numérique dessiné avec des formules mathématiques, pouvant être redimensionné à volonté sans perte de qualité."
    }
  ]
