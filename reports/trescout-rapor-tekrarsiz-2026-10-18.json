  "glossary": [
    {
      "term": "coding agents",
      "explanation": "Yazılım geliştirme süreçlerinde kod yazma, hata ayıklama ve düzenleme gibi görevleri otonom şekilde yerine getiren yapay zekâ programları."
    },
    {
      "term": "remote runtime",
      "explanation": "Yazılımın veya yapay zekâ işlemlerinin yerel bilgisayar yerine uzak bir sunucu üzerinde çalıştırılmasını sağlayan ortam."
    },
    {
      "term": "multimodal",
      "explanation": "Sadece metinle değil, aynı zamanda görsel, sesli veya diğer veri türlerini aynı anda işleyebilen sistem."
    },
    {
      "term": "associative memory",
      "explanation": "Bilgileri birbirleriyle olan ilişkilerine göre depolayan ve çağrışım yoluyla hatırlayan bir veri işleme mantığı."
    },
    {
      "term": "SVG",
      "explanation": "Kalitesi bozulmadan istenilen boyuta getirilebilen, matematiksel formüllerle çizilen dijital görüntü formatı."
    }
  ]
