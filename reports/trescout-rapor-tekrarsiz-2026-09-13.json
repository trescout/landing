  "glossary": [
    {
      "term": "system prompts",
      "explanation": "Yapay zekâya nasıl davranması ve hangi kurallara göre cevap vermesi gerektiğini belirten başlangıç talimatları."
    },
    {
      "term": "large language models",
      "explanation": "İnsan dilini anlayıp metin üretebilen, çok büyük veriyle eğitilmiş yapay zekâ modelleri."
    },
    {
      "term": "GPU",
      "explanation": "Bilgisayardaki görüntüleri işleyen ve karmaşık matematiksel hesaplamaları hızlandıran özel işlemci."
    },
    {
      "term": "offensive security skills",
      "explanation": "Sistemlerdeki açıkları bulmak için saldırgan gibi düşünerek güvenlik testleri yapma becerisi."
    },
    {
      "term": "zero-shot",
      "explanation": "Yapay zekânın daha önce hiç örnek görmediği bir konuda, sadece talimatla doğru sonuç üretmesi."
    },
    {
      "term": "worktree",
      "explanation": "Yazılım geliştirirken aynı projenin farklı sürümleri üzerinde aynı anda çalışmanıza izin veren klasör yapısı."
    },
    {
      "term": "CLI",
      "explanation": "Programları fareyle değil, yazılı komutlarla çalıştıran metin tabanlı arayüz."
    }
  ]
}