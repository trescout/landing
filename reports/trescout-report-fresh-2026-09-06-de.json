  "glossary": [
    {
      "term": "skills",
      "explanation": "Spezielle Fähigkeiten oder Werkzeugnutzungsfertigkeiten, die KI-Modelle erwerben, um eine bestimmte Aufgabe zu erfüllen."
    },
    {
      "term": "LLM",
      "explanation": "Ein fortschrittliches KI-Modell, das mit einer riesigen Datenmenge trainiert wurde, um menschliche Sprache zu verstehen und Texte zu generieren."
    },
    {
      "term": "hooks",
      "explanation": "Verbindungspunkte, die es ermöglichen, während des Betriebs einer Software an einem bestimmten Punkt einzugreifen und den Prozess zu beeinflussen."
    },
    {
      "term": "instances",
      "explanation": "Jede einzelne, gleichzeitig laufende, unabhängige Kopie einer Software oder eines Systems."
    }
  ]
