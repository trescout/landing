  "glossary": [
    {
      "term": "skills",
      "explanation": "Habilidades especiais ou capacidades de uso de ferramentas que modelos de inteligência artificial adquirem para realizar uma tarefa específica."
    },
    {
      "term": "LLM",
      "explanation": "Modelo avançado de inteligência artificial treinado com uma enorme quantidade de dados, capaz de entender a linguagem humana e gerar texto."
    },
    {
      "term": "hooks",
      "explanation": "Pontos de conexão que permitem intervir no processo ao serem acionados em um momento específico durante a execução de um software."
    },
    {
      "term": "instances",
      "explanation": "Cada cópia independente de um software ou sistema em execução simultânea."
    }
  ]
