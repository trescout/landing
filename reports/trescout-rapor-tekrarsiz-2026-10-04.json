  "glossary": [
    {
      "term": "API",
      "explanation": "İki farklı yazılımın birbirleriyle konuşmasını ve veri alışverişi yapmasını sağlayan dijital köprü."
    },
    {
      "term": "persistent context",
      "explanation": "Yapay zekânın önceki konuşmaları unutmayıp, uzun süreli etkileşimlerde bilgileri hafızasında tutabilme yeteneği."
    },
    {
      "term": "agent workspace",
      "explanation": "Yapay zekâ destekli yardımcıların görevlerini yerine getirirken kullandığı, tüm araçlara ve verilere erişebildiği çalışma alanı."
    },
    {
      "term": "large language models",
      "explanation": "İnsan dilini anlayıp metin üretebilen, çok büyük veriyle eğitilmiş yapay zekâ modelleri."
    },
    {
      "term": "framework",
      "explanation": "Yazılım geliştirirken işleri kolaylaştıran, hazır kod yapıları ve kurallar bütünü sunan temel çatı."
    },
    {
      "term": "hard budget caps",
      "explanation": "Bir projenin veya sistemin harcayabileceği kaynağın, teknik olarak aşılması imkânsız olan kesin üst sınırı."
    }
  ]
}