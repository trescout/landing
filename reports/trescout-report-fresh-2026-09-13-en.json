  "glossary": [
    {
      "term": "system prompts",
      "explanation": "Initial instructions that specify how artificial intelligence should behave and according to which rules it should respond."
    },
    {
      "term": "large language models",
      "explanation": "Artificial intelligence models trained on massive amounts of data that can understand human language and generate text."
    },
    {
      "term": "GPU",
      "explanation": "A specialized processor that processes images on a computer and accelerates complex mathematical calculations."
    },
    {
      "term": "offensive security skills",
      "explanation": "The skill of performing security tests by thinking like an attacker to find vulnerabilities in systems."
    },
    {
      "term": "zero-shot",
      "explanation": "The ability of artificial intelligence to produce accurate results on a topic it has never seen an example of before, using only instructions."
    },
    {
      "term": "worktree",
      "explanation": "A folder structure that allows you to work on different versions of the same project simultaneously while developing software."
    },
    {
      "term": "CLI",
      "explanation": "A text-based interface that runs programs using written commands instead of a mouse."
    }
  ]
